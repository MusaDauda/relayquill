# Relayquill runtime environment configuration example.
# Copy to .env (git-ignored) and supply local or deployment values as needed.
# Never commit real secrets, NKey seeds, or credential-bearing URLs.

# Runtime environment identifier (used for IPC paths/pipes and config resolution)
RELAYQUILL_ENV=development

# Standard PostgreSQL 18 connection strings (runtime pool and direct migration/admin URL)
# Self-hosted production example: postgres://rq_api@pg.internal:5432/relayquill?sslmode=verify-full
DATABASE_URL=postgres://rq_api@127.0.0.1:55005/relayquill
DIRECT_DATABASE_URL=postgres://rq_migrator@127.0.0.1:55005/relayquill

# Independent example database connection strings (isolated rc and pi authorities)
RECEIVER_DATABASE_URL=postgres://receiver_runtime@127.0.0.1:55005/relayquill_receiver
PROVIDER_INGRESS_DATABASE_URL=postgres://provider_runtime@127.0.0.1:55005/relayquill_provider

# NATS JetStream connection (self-hosted Go/TLS NATS cluster or local dev broker)
# Self-hosted TLS cluster example: tls://broker-1.internal:4222,tls://broker-2.internal:4222,tls://broker-3.internal:4222
NATS_URL=nats://127.0.0.1:14225

# Self-hosted NATS NKey seed file path (used by relay, fanout, and admin broker roles)
NATS_NKEY_SEED_FILE=

# Optional NATS credentials file path (for JWT/creds auth or optional remote dev broker)
NATS_CREDS_FILE=

# Public browser console and API origins (keep same-origin or localhost for WebAuthn passkeys)
PUBLIC_CONSOLE_ORIGIN=http://localhost:5205
PUBLIC_API_ORIGIN=http://127.0.0.1:8005
WEBAUTHN_RP_ID=localhost

# Optional provider callback test-mode secrets (for examples/provider-ingress conformance)
STRIPE_WEBHOOK_SECRET=
PAYSTACK_TEST_SECRET_KEY=

# Optional OpenTelemetry OTLP HTTP exporter endpoint (leave unset to disable remote export)
OTEL_EXPORTER_OTLP_ENDPOINT=
