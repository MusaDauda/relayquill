{
  "$schema": "./schema/role-config.schema.json",
  "schema_version": 1,
  "profile": "development_trusted_local",
  "process_role": "admin",
  "command_role": "db_and_broker_admin",
  "database": {
    "mode": "development_trusted_local",
    "isolation": "separate_databases",
    "host": "127.0.0.1",
    "port": 55005,
    "name": "relayquill",
    "schema": "rq",
    "support_schema": "rq_support",
    "role": "rq_migrator",
    "authentication": "trusted_local_only",
    "tls_mode": "disabled_fixture",
    "pool_mode": "direct",
    "maximum_connections": 2,
    "connection_timeout_ms": 5000,
    "statement_timeout_ms": 30000,
    "lock_timeout_ms": 5000
  },
  "broker": {
    "mode": "development_loopback",
    "servers": ["nats://127.0.0.1:14225"],
    "auth_mode": "none_fixture",
    "stream_name": "RELAYQUILL_EVENTS_V1",
    "subject_prefix": "",
    "consumer_name": "RELAYQUILL_FANOUT_V1",
    "replicas": 1,
    "max_msgs": 100000,
    "max_bytes": 268435456,
    "max_msg_size": 4096,
    "max_age_ns": 3600000000000,
    "duplicate_window_ns": 120000000000,
    "inbox_prefix": "_INBOX.rq.admin"
  },
  "migrations_dir": "migrations",
  "protocol": {
    "http_schema_version": 1,
    "broker_envelope_version": 1,
    "webhook_signature_version": 1
  }
}
