{
  "$schema": "./schema/role-config.schema.json",
  "schema_version": 1,
  "profile": "hosted_neon",
  "process_role": "sender",
  "database": {
    "mode": "hosted_neon",
    "isolation": "separate_databases",
    "host": "ep-example-direct.us-east-1.aws.neon.tech",
    "port": 5432,
    "name": "neondb",
    "schema": "rq",
    "support_schema": "rq_support",
    "role": "rq_sender",
    "authentication": "secret_provider_password",
    "password_secret_ref": "env:RELAYQUILL_NEON_PASSWORD_RQ_SENDER",
    "tls_mode": "verify_full",
    "pool_mode": "direct",
    "maximum_connections": 4,
    "connection_timeout_ms": 10000,
    "statement_timeout_ms": 5000,
    "lock_timeout_ms": 2000
  },
  "secret_provider": {
    "mode": "env_reference"
  },
  "sender": {
    "dispatch_domain": "primary",
    "approved_slots": 8,
    "poll_interval_ms": 250,
    "request_timeout_ms": 5000,
    "max_response_bytes": 65536
  },
  "egress": {
    "mode": "strict_public_https",
    "allow_fixture_receiver": false
  },
  "protocol": {
    "http_schema_version": 1,
    "broker_envelope_version": 1,
    "webhook_signature_version": 1
  }
}
