{
  "$schema": "./schema/role-config.schema.json",
  "schema_version": 1,
  "profile": "hosted_supabase",
  "process_role": "api",
  "http": {
    "host": "127.0.0.1",
    "port": 8005,
    "public_origin": "https://console.relayquill.example",
    "trust_proxy": true,
    "sse_heartbeat_ms": 10000,
    "sse_max_lifetime_ms": 60000
  },
  "database": {
    "mode": "hosted_supabase",
    "isolation": "shared_database_schemas",
    "host": "aws-0-us-east-1.pooler.supabase.com",
    "port": 6543,
    "name": "postgres",
    "schema": "rq",
    "support_schema": "extensions",
    "role": "rq_api",
    "authentication": "secret_provider_password",
    "password_secret_ref": "env:RELAYQUILL_SUPABASE_PASSWORD_RQ_API",
    "tls_mode": "verify_full",
    "tls_ca_file": "certs/supabase-prod-ca-2021.crt",
    "pool_mode": "transaction_pooler",
    "maximum_connections": 8,
    "connection_timeout_ms": 10000,
    "statement_timeout_ms": 5000,
    "lock_timeout_ms": 2000
  },
  "auth": {
    "rp_id": "console.relayquill.example",
    "allowed_origins": ["https://console.relayquill.example"],
    "cookie_profile": "release_https"
  },
  "secret_provider": {
    "mode": "env_reference"
  },
  "protocol": {
    "http_schema_version": 1,
    "broker_envelope_version": 1,
    "webhook_signature_version": 1
  }
}
