{
  "$schema": "./schema/role-config.schema.json",
  "schema_version": 1,
  "profile": "hosted_supabase",
  "process_role": "relay",
  "database": {
    "mode": "hosted_supabase",
    "isolation": "shared_database_schemas",
    "host": "aws-0-us-east-1.pooler.supabase.com",
    "port": 5432,
    "name": "postgres",
    "schema": "rq",
    "support_schema": "extensions",
    "role": "rq_relay",
    "authentication": "secret_provider_password",
    "password_secret_ref": "env:RELAYQUILL_SUPABASE_PASSWORD_RQ_RELAY",
    "tls_mode": "verify_full",
    "tls_ca_file": "certs/supabase-prod-ca-2021.crt",
    "pool_mode": "session_pooler",
    "maximum_connections": 4,
    "connection_timeout_ms": 10000,
    "statement_timeout_ms": 5000,
    "lock_timeout_ms": 2000
  },
  "broker": {
    "mode": "hosted_synadia_ngs",
    "servers": ["tls://connect.ngs.global"],
    "auth_mode": "synadia_creds_jwt",
    "secret_ref": "env:RELAYQUILL_NATS_CREDS_RELAY",
    "tls": {
      "enabled": true,
      "handshake_first": false,
      "reject_unauthorized": true
    },
    "stream_name": "RELAYQUILL_EVENTS_V1",
    "subject_prefix": "",
    "consumer_name": "RELAYQUILL_FANOUT_V1",
    "replicas": 1,
    "max_msgs": 100000,
    "max_bytes": 268435456,
    "max_msg_size": 4096,
    "max_age_ns": 3600000000000,
    "duplicate_window_ns": 120000000000,
    "inbox_prefix": "_INBOX.rq.relay"
  },
  "relay": {
    "poll_interval_ms": 250,
    "batch_size": 32,
    "claim_lease_ms": 30000,
    "publish_concurrency": 16,
    "publish_timeout_ms": 5000
  },
  "protocol": {
    "http_schema_version": 1,
    "broker_envelope_version": 1,
    "webhook_signature_version": 1
  }
}
