{
  "$schema": "./schema/role-config.schema.json",
  "schema_version": 1,
  "profile": "hosted_synadia_ngs",
  "process_role": "fanout",
  "database": {
    "mode": "hosted_neon",
    "isolation": "separate_databases",
    "host": "ep-example-direct.us-east-1.aws.neon.tech",
    "port": 5432,
    "name": "neondb",
    "schema": "rq",
    "support_schema": "rq_support",
    "role": "rq_fanout",
    "authentication": "secret_provider_password",
    "password_secret_ref": "env:RELAYQUILL_NEON_PASSWORD_RQ_FANOUT",
    "tls_mode": "verify_full",
    "pool_mode": "direct",
    "maximum_connections": 4,
    "connection_timeout_ms": 10000,
    "statement_timeout_ms": 5000,
    "lock_timeout_ms": 2000
  },
  "broker": {
    "mode": "hosted_synadia_ngs",
    "servers": ["tls://connect.ngs.global"],
    "auth_mode": "synadia_creds_jwt",
    "secret_ref": "env:RELAYQUILL_NATS_CREDS_FANOUT",
    "tls": {
      "enabled": true,
      "handshake_first": false,
      "reject_unauthorized": true
    },
    "stream_name": "RELAYQUILL_EVENTS_V1",
    "subject_prefix": "rq_prod.",
    "consumer_name": "RELAYQUILL_FANOUT_V1",
    "replicas": 1,
    "max_msgs": 100000,
    "max_bytes": 268435456,
    "max_msg_size": 4096,
    "max_age_ns": 3600000000000,
    "duplicate_window_ns": 120000000000,
    "inbox_prefix": "_INBOX.rq.fanout"
  },
  "fanout": {
    "ack_wait_ms": 30000,
    "max_deliver": 10,
    "max_ack_pending": 128,
    "max_batch": 32,
    "max_bytes": 262144,
    "max_expires_ms": 5000
  },
  "protocol": {
    "http_schema_version": 1,
    "broker_envelope_version": 1,
    "webhook_signature_version": 1
  }
}
