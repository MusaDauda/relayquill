{
  "$schema": "./schema/role-config.schema.json",
  "schema_version": 1,
  "profile": "portable_pglite",
  "process_role": "api",
  "http": {
    "host": "127.0.0.1",
    "port": 8005,
    "public_origin": "http://localhost:5205",
    "sse_heartbeat_ms": 10000,
    "sse_max_lifetime_ms": 60000
  },
  "database": {
    "mode": "portable_pglite",
    "isolation": "separate_databases",
    "host": "in-memory",
    "port": 0,
    "name": "relayquill",
    "schema": "rq",
    "support_schema": "rq_support",
    "role": "rq_api",
    "authentication": "in_process_pglite",
    "tls_mode": "in_process",
    "pool_mode": "direct",
    "maximum_connections": 1,
    "connection_timeout_ms": 5000,
    "statement_timeout_ms": 5000,
    "lock_timeout_ms": 2000
  },
  "auth": {
    "rp_id": "localhost",
    "allowed_origins": ["http://localhost:5205"],
    "cookie_profile": "development_only"
  },
  "secret_provider": {
    "mode": "in_memory_test"
  },
  "operator_channel": {
    "env_name": "portable",
    "channel": "api-admin"
  },
  "protocol": {
    "http_schema_version": 1,
    "broker_envelope_version": 1,
    "webhook_signature_version": 1
  }
}
