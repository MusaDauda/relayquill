{
  "$schema": "./schema/role-config.schema.json",
  "schema_version": 1,
  "profile": "release",
  "process_role": "provider_ingress",
  "http": {
    "host": "0.0.0.0",
    "port": 19096,
    "trust_proxy": true
  },
  "database": {
    "mode": "release_rds_iam",
    "isolation": "separate_databases",
    "host": "relayquill-pi-pg.example.us-east-1.rds.amazonaws.com",
    "port": 5432,
    "name": "relayquill_provider",
    "schema": "pi",
    "support_schema": "rq_support",
    "role": "provider_runtime",
    "authentication": "aws_rds_iam_token",
    "tls_mode": "verify_full",
    "tls_ca_file": "/etc/relayquill/certs/aws-rds-global-bundle.pem",
    "pool_mode": "direct",
    "maximum_connections": 8,
    "connection_timeout_ms": 5000,
    "statement_timeout_ms": 5000,
    "lock_timeout_ms": 2000
  },
  "secret_provider": {
    "mode": "aws_secrets_manager",
    "region": "us-east-1",
    "secret_prefix": "relayquill/prod/provider-ingress/"
  },
  "relayquill_api": {
    "origin": "https://api.relayquill.example",
    "project_id": "00000000-0000-4000-8000-000000000001",
    "credential_secret_ref": "aws-sm:relayquill/prod/provider-ingress/producer-credential"
  },
  "protocol": {
    "http_schema_version": 1,
    "broker_envelope_version": 1,
    "webhook_signature_version": 1
  }
}
