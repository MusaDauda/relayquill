{
  "$schema": "./schema/role-config.schema.json",
  "schema_version": 1,
  "profile": "self_hosted",
  "process_role": "api",
  "http": {
    "host": "0.0.0.0",
    "port": 8005,
    "public_origin": "https://console.relayquill.example",
    "trust_proxy": true,
    "sse_heartbeat_ms": 10000,
    "sse_max_lifetime_ms": 60000
  },
  "database": {
    "mode": "standard_tls",
    "isolation": "separate_databases",
    "host": "postgres.internal.relayquill.example",
    "port": 5432,
    "name": "relayquill",
    "schema": "rq",
    "support_schema": "rq_support",
    "role": "rq_api",
    "authentication": "secret_provider_password",
    "password_secret_ref": "file:/run/secrets/pg_password_rq_api",
    "tls_mode": "verify_full",
    "tls_ca_file": "/etc/relayquill/certs/postgres-ca.pem",
    "pool_mode": "direct",
    "maximum_connections": 16,
    "connection_timeout_ms": 5000,
    "statement_timeout_ms": 5000,
    "lock_timeout_ms": 2000
  },
  "auth": {
    "rp_id": "console.relayquill.example",
    "allowed_origins": ["https://console.relayquill.example"],
    "cookie_profile": "release_https"
  },
  "secret_provider": {
    "mode": "mounted_file",
    "secrets_dir": "/run/secrets"
  },
  "operator_channel": {
    "env_name": "prod",
    "channel": "api-admin"
  },
  "telemetry": {
    "enabled": true,
    "service_name": "relayquill-api",
    "max_queue_size": 2048,
    "max_export_batch_size": 256
  },
  "protocol": {
    "http_schema_version": 1,
    "broker_envelope_version": 1,
    "webhook_signature_version": 1
  }
}
