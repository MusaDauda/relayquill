{
  "$schema": "https://developer.microsoft.com/json-schemas/api-extractor/v7/api-extractor.schema.json",
  "mainEntryPointFilePath": "<projectFolder>/build/types/index.d.ts",
  "bundledPackages": [
    "@relayquill/contracts",
    "@relayquill/domain",
    "@relayquill/signing"
  ],
  "compiler": {
    "tsconfigFilePath": "<projectFolder>/tsconfig.types.json"
  },
  "apiReport": {
    "enabled": true,
    "reportFolder": "<projectFolder>/build/api-report",
    "reportTempFolder": "<projectFolder>/build/api-report-temp"
  },
  "docModel": {
    "enabled": false
  },
  "dtsRollup": {
    "enabled": true,
    "untrimmedFilePath": "<projectFolder>/dist/index.d.ts"
  },
  "tsdocMetadata": {
    "enabled": false
  },
  "messages": {
    "compilerMessageReporting": {
      "default": {
        "logLevel": "warning"
      }
    },
    "extractorMessageReporting": {
      "default": {
        "logLevel": "warning"
      },
      "ae-missing-release-tag": {
        "logLevel": "none"
      },
      "ae-forgotten-export": {
        "logLevel": "error"
      }
    }
  }
}
